includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
	- phpstan-baseline.neon

parameters:
	level: 5
	paths:
		- src
		- nexo-mcp.php
		- uninstall.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
	dynamicConstantNames:
		- NEXO_MCP_VERSION
	tmpDir: /tmp/nexo-mcp-phpstan
	ignoreErrors:
		# BearerTokenGuard::requested_route() decide en qué rutas vale el token.
		# Lee las constantes a propósito: wp_doing_ajax() pasa por un filtro que
		# otro plugin podría alterar, e is_admin() depende de la pantalla actual.
		-
			message: '#^Found usage of constant (WP_ADMIN|DOING_AJAX)\. Use (is_admin|wp_doing_ajax)\(\) instead\.$#'
			path: src/OAuth/BearerTokenGuard.php
			count: 2
