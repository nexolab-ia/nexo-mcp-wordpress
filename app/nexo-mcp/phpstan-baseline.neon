parameters:
	ignoreErrors:
		-
			message: '#^Constant NEXO_MCP_PATH not found\.$#'
			identifier: constant.notFound
			count: 2
			path: src/Admin/AdminPage.php

		-
			message: '#^Call to function is_array\(\) with array\<string, mixed\> will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Admin/LicenseController.php

		-
			message: '#^Offset ''logo'' does not exist on array\{name\: string, mark\: ''\+''\|''AG''\|''CU''\|''GM''\|''WS'', oauth\: true, kind\: ''file'', intro\: string, code\: string, after\: string\}\|array\{name\: string, mark\: ''CL''\|''VS'', oauth\: true, kind\: ''command'', intro\: string, code\: non\-falsy\-string, after\: string\}\|array\{name\: string, mark\: ''CX'', oauth\: true, kind\: ''bridge'', codex_bridge\: true, intro\: string, code\: non\-falsy\-string, native_code\: non\-falsy\-string, \.\.\.\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Admin/views/dashboard.php

		-
			message: '#^Offset ''logo'' on array\{name\: string, mark\: ''\+''\|''AG''\|''CU''\|''GM''\|''WS'', oauth\: true, kind\: ''file'', intro\: string, code\: string, after\: string\}\|array\{name\: string, mark\: ''CL''\|''VS'', oauth\: true, kind\: ''command'', intro\: string, code\: non\-falsy\-string, after\: string\}\|array\{name\: string, mark\: ''CX'', oauth\: true, kind\: ''bridge'', codex_bridge\: true, intro\: string, code\: non\-falsy\-string, native_code\: non\-falsy\-string, \.\.\.\} in empty\(\) does not exist\.$#'
			identifier: empty.offset
			count: 1
			path: src/Admin/views/dashboard.php

		-
			message: '#^Ternary operator condition is always true\.$#'
