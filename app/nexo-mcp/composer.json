{
  "name": "nexodev/nexo-mcp",
  "description": "Nexo MCP: conector MCP seguro para WordPress y WooCommerce (obra derivada GPL de MCP Prisma, de SICS).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "wordpress/mcp-adapter": "^0.5",
    "wordpress/php-mcp-schema": "^0.1"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3"
  },
  "autoload": {
    "psr-4": {
      "NexoDev\\NexoMCP\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NexoDev\\NexoMCP\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.30"
    },
    "allow-plugins": {
      "automattic/jetpack-autoloader": false,
      "composer/installers": false,
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
